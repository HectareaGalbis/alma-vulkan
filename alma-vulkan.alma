; Vulkan para ALMA
;
; Declaraciones de <vulkan/vulkan.h> (vulkan_core.h, Vulkan 1.3.275, y las
; cabeceras de video vk_video/*.h que incluye) escritas en ALMA. Generado a
; partir de las cabeceras oficiales de Khronos.
;
; Uso: carga este archivo al principio del programa (load necesita una ruta
; absoluta) y enlaza con libvulkan:
;
;   (load "/ruta/a/alma-vulkan/vulkan.alma")
;   ./alma -o prog prog.alma -lvulkan
;
; ALMA no tiene typedef ni campos de bits, asi que:
;
; - Los handles son punteros a structs opacos, como en la cabecera de C
;   (typedef struct VkInstance_T *VkInstance): VkInstance es (VkInstance_T *)
;   y VkInstance * es (VkInstance_T * *).
; - Los demas typedef son macros sin parametros que devuelven el tipo, y se
;   usan como tipos escribiendo (Nombre):
;     (VkInstance)            -> (VkInstance_T *)
;     (VkBool32)              -> uint32_t
;     (VkDeviceSize)          -> uint64_t
;     (VkImageUsageFlags)     -> uint32_t
;     (PFN_vkCreateInstance)  -> puntero a funcion
;   Las que devuelven un simbolo tambien sirven con especificadores:
;   ((VkDeviceSize) *) es (uint64_t *). Las declaraciones de este archivo usan
;   siempre los tipos ya expandidos.
; - Las constantes de los enums son constantes de C normales (VK_SUCCESS). Los
;   #define y los bits de 64 bits (static const VkFlags64) son macros:
;   (VK_TRUE), (VK_WHOLE_SIZE), (VK_API_VERSION_1_3),
;   (VK_PIPELINE_STAGE_2_TRANSFER_BIT), (VK_KHR_SWAPCHAIN_EXTENSION_NAME)...
;   VK_MAKE_API_VERSION y similares son macros con parametros.
; - VK_NULL_HANDLE es la macro (VK_NULL_HANDLE), que vale NULL.
; - Los campos de bits de C (p. ej. VkAccelerationStructureInstanceKHR y los
;   structs *Flags de video) se agrupan en miembros uint32_t llamados bits0,
;   bits1... con la misma disposicion en memoria. Un comentario antes de cada
;   struct indica que bits ocupa cada campo.
; - Los parametros de tipo array (const float blendConstants[4]) son punteros.
; - Se asume una plataforma de 64 bits (handles no despachables = punteros).
(macro VK_USE_64_BIT_PTR_DEFINES () 1)
(macro VK_NULL_HANDLE () 'NULL)

; -----------------------------------------------------------------------------
; vulkan/vulkan_core.h

(macro VK_VERSION_1_0 () 1)
(macro VK_MAKE_API_VERSION (variant major minor patch)
  `(bit-or (<< (cast uint32_t ,variant) 29) (<< (cast uint32_t ,major) 22)
           (<< (cast uint32_t ,minor) 12) (cast uint32_t ,patch)))
(macro VK_API_VERSION_1_0 () '(VK_MAKE_API_VERSION 0 1 0 0))
(macro VK_HEADER_VERSION () 275)
(macro VK_HEADER_VERSION_COMPLETE () '(VK_MAKE_API_VERSION 0 1 3 (VK_HEADER_VERSION)))
(macro VK_MAKE_VERSION (major minor patch)
  `(bit-or (<< (cast uint32_t ,major) 22) (<< (cast uint32_t ,minor) 12) (cast uint32_t ,patch)))
(macro VK_VERSION_MAJOR (version) `(>> (cast uint32_t ,version) 22))
(macro VK_VERSION_MINOR (version) `(bit-and (>> (cast uint32_t ,version) 12) (cast uint32_t 1023)))
(macro VK_VERSION_PATCH (version) `(bit-and (cast uint32_t ,version) (cast uint32_t 4095)))
(macro VK_API_VERSION_VARIANT (version) `(>> (cast uint32_t ,version) 29))
(macro VK_API_VERSION_MAJOR (version) `(bit-and (>> (cast uint32_t ,version) 22) (cast uint32_t 127)))
(macro VK_API_VERSION_MINOR (version) `(bit-and (>> (cast uint32_t ,version) 12) (cast uint32_t 1023)))
(macro VK_API_VERSION_PATCH (version) `(bit-and (cast uint32_t ,version) (cast uint32_t 4095)))
